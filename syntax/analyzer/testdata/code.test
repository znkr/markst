--- string-literal ---
#"hello world"
│ fn $top:
│   b0:
│     v0 = const hello world
│     return v0

--- identifier ---
#let foo
#foo
│ fn $top:
│   b0:
│     v0 = const none
│     return v0

--- field-access ---
#let foo = (bar: "bar")
#foo.bar
│ fn $top:
│   b0:
│     v0 = const bar
│     v1 = const bar
│     v2 = make_dict (v0: v1)
│     v3 = field_read v2.bar
│     return v3

--- nested-field-access ---
#let foo = (bar: (baz: "baz"))
#foo.bar.baz
│ fn $top:
│   b0:
│     v0 = const bar
│     v1 = const baz
│     v2 = const baz
│     v3 = make_dict (v1: v2)
│     v4 = make_dict (v0: v3)
│     v5 = field_read v4.bar
│     v6 = field_read v5.baz
│     return v6

--- code-block-empty ---
#{}
│ fn $top:
│   b0:
│     v0 = const none
│     return v0

--- code-block-single ---
#{ 1 }
│ fn $top:
│   b0:
│     v0 = const 1
│     return v0

--- code-block-multiple ---
#{ 1; 2; 3 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = const 3
│     v3 = code_join [v0, v1, v2]
│     return v3

--- content-block-in-code ---
#{ [hello *world*] }
│ fn $top:
│   b0:
│     v0 = const text "hello"
│     v1 = const text "world"
│     v2 = strong v1
│     v3 = content_result [v0, v2]
│     return v3

--- parenthesized ---
#{ (1) }
│ fn $top:
│   b0:
│     v0 = const 1
│     return v0

--- unary-plus ---
#{ +1 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = + v0
│     return v1

--- unary-minus ---
#{ -1 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = - v0
│     return v1

--- unary-not ---
#{ not true }
│ fn $top:
│   b0:
│     v0 = const true
│     v1 = not v0
│     return v1

--- binary-addition ---
#{ 1 + 2 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = v0 + v1
│     return v2

--- binary-subtraction ---
#{ 3 - 4 }
│ fn $top:
│   b0:
│     v0 = const 3
│     v1 = const 4
│     v2 = v0 - v1
│     return v2

--- binary-multiplication ---
#{ 5 * 6 }
│ fn $top:
│   b0:
│     v0 = const 5
│     v1 = const 6
│     v2 = v0 * v1
│     return v2

--- binary-division ---
#{ 7 / 8 }
│ fn $top:
│   b0:
│     v0 = const 7
│     v1 = const 8
│     v2 = v0 / v1
│     return v2

--- binary-equality ---
#{ 1 == 2 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = v0 == v1
│     return v2

--- binary-inequality ---
#{ 3 != 4 }
│ fn $top:
│   b0:
│     v0 = const 3
│     v1 = const 4
│     v2 = v0 != v1
│     return v2

--- binary-less-than ---
#{ 5 < 6 }
│ fn $top:
│   b0:
│     v0 = const 5
│     v1 = const 6
│     v2 = v0 < v1
│     return v2

--- binary-less-than-or-equal ---
#{ 7 <= 8 }
│ fn $top:
│   b0:
│     v0 = const 7
│     v1 = const 8
│     v2 = v0 <= v1
│     return v2

--- binary-greater-than ---
#{ 9 > 10 }
│ fn $top:
│   b0:
│     v0 = const 9
│     v1 = const 10
│     v2 = v0 > v1
│     return v2

--- binary-greater-than-or-equal ---
#{ 11 >= 12 }
│ fn $top:
│   b0:
│     v0 = const 11
│     v1 = const 12
│     v2 = v0 >= v1
│     return v2

--- binary-and ---
#{ true and false }
│ fn $top:
│   b0:
│     v0 = const true
│     branch v0, b1, b2
│   b1:
│     v1 = const false
│     v2 = v0 and v1
│     jump b2
│   b2:
│     v3 = phi [b0 v0, b1 v2]
│     return v3

--- binary-or ---
#{ true or false }
│ fn $top:
│   b0:
│     v0 = const true
│     branch v0, b2, b1
│   b1:
│     v1 = const false
│     v2 = v0 or v1
│     jump b2
│   b2:
│     v3 = phi [b0 v0, b1 v2]
│     return v3

--- binary-in ---
#let x = 1
#let y = (1,)
#{ x in y }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 1
│     v2 = make_array [v1]
│     v3 = v0 in v2
│     return v3

--- binary-not-in ---
#let x = 1
#let y = (1,)
#{ x not in y }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 1
│     v2 = make_array [v1]
│     v3 = v0 not in v2
│     return v3

--- binary-assignment ---
#let x
#{ x = 1 }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const 1
│     v2 = const none
│     return v2

--- binary-add-assign ---
#let x = 2
#{ x += 2 }
│ fn $top:
│   b0:
│     v0 = const 2
│     v1 = const 2
│     v2 = v0 + v1
│     v3 = const none
│     return v3

--- binary-sub-assign ---
#let x = 2
#{ x -= 3 }
│ fn $top:
│   b0:
│     v0 = const 2
│     v1 = const 3
│     v2 = v0 - v1
│     v3 = const none
│     return v3

--- binary-mul-assign ---
#let x = 2
#{ x *= 4 }
│ fn $top:
│   b0:
│     v0 = const 2
│     v1 = const 4
│     v2 = v0 * v1
│     v3 = const none
│     return v3

--- binary-div-assign ---
#let x = 2
#{ x /= 5 }
│ fn $top:
│   b0:
│     v0 = const 2
│     v1 = const 5
│     v2 = v0 / v1
│     v3 = const none
│     return v3

--- operator-precedence-mul-over-add ---
#{ 1 + 2 * 3 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = const 3
│     v3 = v1 * v2
│     v4 = v0 + v3
│     return v4

--- operator-precedence-with-parens ---
#{ (1 + 2) * 3 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = v0 + v1
│     v3 = const 3
│     v4 = v2 * v3
│     return v4

--- left-associativity ---
#{ 1 - 2 - 3 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = v0 - v1
│     v3 = const 3
│     v4 = v2 - v3
│     return v4

--- right-associativity-assignment ---
#let x
#let y
#{ x = y = 1 }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = const 1
│     v3 = const none
│     v4 = const none
│     return v4

--- empty-array ---
#()
│ fn $top:
│   b0:
│     v0 = make_array []
│     return v0

--- single-element-array ---
#(1,)
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = make_array [v0]
│     return v1

--- multi-element-array ---
#(1, 2, 3)
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = const 3
│     v3 = make_array [v0, v1, v2]
│     return v3

--- empty-dictionary ---
#(:)
│ fn $top:
│   b0:
│     v0 = make_dict ()
│     return v0

--- dictionary-with-named-entries ---
#(a: 1, b: 2)
│ fn $top:
│   b0:
│     v0 = const a
│     v1 = const 1
│     v2 = const b
│     v3 = const 2
│     v4 = make_dict (v0: v1, v2: v3)
│     return v4

--- dictionary-with-keyed-entries ---
#("key": "value")
│ fn $top:
│   b0:
│     v0 = const key
│     v1 = const value
│     v2 = make_dict (v0: v1)
│     return v2

--- function-call-no-args ---
#let foo
#foo()
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = call v0()
│     return v1

--- function-call-with-args ---
#let foo
#{ foo(1, 2) }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const 1
│     v2 = const 2
│     v3 = call v0(v1, v2)
│     return v3

--- function-call-with-named-args ---
#let foo
#{ foo(a: 1, b: 2) }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const 1
│     v2 = const 2
│     v3 = call v0(a: v1, b: v2)
│     return v3

--- function-call-with-spread ---
#let foo
#let args
#{ foo(..args) }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = call v0(..v1)
│     return v2

--- function-call-with-content-block ---
#let foo
#foo[hello]
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const text "hello"
│     v2 = content_result [v1]
│     v3 = call v0()[v2]
│     return v3

--- function-call-with-multiple-content-blocks ---
#let foo
#foo[hello][world]
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const text "hello"
│     v2 = content_result [v1]
│     v3 = const text "world"
│     v4 = content_result [v3]
│     v5 = call v0()[v2][v4]
│     return v5

--- function-call-with-args-and-content ---
#let foo
#foo(1)[hello]
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const 1
│     v2 = const text "hello"
│     v3 = content_result [v2]
│     v4 = call v0(v1)[v3]
│     return v4

--- method-call ---
#let foo
#foo.bar()
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = field_read v0.bar
│     v2 = call v1()
│     return v2

--- simple-closure ---
#{ x => x + 1 }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_0
│     return v0
│ 
│ fn $fn_0 params=[v0=x]:
│   b0:
│     v1 = const 1
│     v2 = v0 + v1
│     return v2

--- underscore-closure ---
#{ _ => 42 }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_0
│     return v0
│ 
│ fn $fn_0 params=[v0=_]:
│   b0:
│     v1 = const 42
│     return v1

--- multi-param-closure ---
#{ (x, y) => x + y }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_0
│     return v0
│ 
│ fn $fn_0 params=[v0=x, v1=y]:
│   b0:
│     v2 = v0 + v1
│     return v2

--- closure-with-default-param ---
#{ (a, b: 1) => a + b }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = make_closure $fn_0 captures=[v0]
│     return v1
│ 
│ fn $fn_0 captures=[v1=$default$b] params=[v0=a, v2=b:v1]:
│   b0:
│     v3 = v0 + v2
│     return v3

--- closure-with-spread-param ---
#{ (..args) => args }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_0
│     return v0
│ 
│ fn $fn_0 params=[v0=..args]:
│   b0:
│     return v0

--- nested-closures ---
#{ x => y => x + y }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_1
│     return v0
│ 
│ fn $fn_0 captures=[v1=x] params=[v0=y]:
│   b0:
│     v2 = v1 + v0
│     return v2
│ 
│ fn $fn_1 params=[v0=x]:
│   b0:
│     v1 = make_closure $fn_0 captures=[v0]
│     return v1

--- transitive-capture ---
#{ let n = 10; () => () => n }
│ fn $top:
│   b0:
│     v0 = const 10
│     v1 = make_closure $fn_1 captures=[v0]
│     return v1
│ 
│ fn $fn_0 captures=[v0=n]:
│   b0:
│     return v0
│ 
│ fn $fn_1 captures=[v0=n]:
│   b0:
│     v1 = make_closure $fn_0 captures=[v0]
│     return v1

--- transitive-capture-shared ---
#{ let n = 10; () => (n, () => n) }
│ fn $top:
│   b0:
│     v0 = const 10
│     v1 = make_closure $fn_1 captures=[v0]
│     return v1
│ 
│ fn $fn_0 captures=[v0=n]:
│   b0:
│     return v0
│ 
│ fn $fn_1 captures=[v0=n]:
│   b0:
│     v1 = make_closure $fn_0 captures=[v0]
│     v2 = make_array [v0, v1]
│     return v2

--- let-binding-simple ---
#{ let x = 1 }
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const none
│     return v1

--- let-binding-no-code-block ---
#let x = 1
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const none
│     return v1

--- let-binding-pattern ---
#let pair
#{ let (a, b) = pair }
│ fn $top:
│   b0:
│     v0 = const none
│     length_check v0, want=2
│     v2 = extract v0[0]
│     v3 = extract v0[1]
│     v4 = const none
│     return v4

--- let-binding-without-assignment ---
#{ let x }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     return v1

--- let-function ---
#{ let add(x, y) = x + y }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_0
│     v1 = const none
│     return v1
│ 
│ fn $fn_0 name="add" params=[v0=x, v1=y]:
│   b0:
│     v2 = v0 + v1
│     return v2

--- set-rule ---
#let text
#{ set text(size: 12pt) }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const 12pt
│     v2 = set_rule v0
│     return v2

--- set-rule-with-condition ---
#let text
#let red
#let enabled
#{ set text(red) if enabled }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = const none
│     v3 = set_rule v0
│     return v3

--- set-rule-with-field-access ---
#let table
#let blue
#{ set table.cell(fill: blue) }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = field_read v0.cell
│     v3 = set_rule v2
│     return v3

--- show-rule-without-selector ---
#let emph
#{ show: emph }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = show_rule: v0
│     return v1

--- show-rule-with-selector ---
#let heading
#let emph
#{ show heading: it => emph(it.body) }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = make_closure $fn_0 captures=[v1]
│     v3 = show_rule v0: v2
│     return v3
│ 
│ fn $fn_0 captures=[v1=emph] params=[v0=it]:
│   b0:
│     v2 = field_read v0.body
│     v3 = call v1(v2)
│     return v3

--- conditional-if-only ---
#let x
#let y
#{ if x { y } }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     branch v0, b2, b3
│   b1:
│     v3 = phi [b2 v1, b3 v2]
│     return v3
│   b2:
│     jump b1
│   b3:
│     v2 = const none
│     jump b1

--- conditional-if-else ---
#let x
#let y
#let z
#{ if x { y } else { z } }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = const none
│     branch v0, b2, b3
│   b1:
│     v3 = phi [b2 v1, b3 v2]
│     return v3
│   b2:
│     jump b1
│   b3:
│     jump b1

--- conditional-else-if ---
#let a
#let b
#{ if a { 1 } else if b { 2 } else { 3 } }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     branch v0, b2, b3
│   b1:
│     v5 = phi [b2 v2, b4 v3, b5 v4]
│     return v5
│   b2:
│     v2 = const 1
│     jump b1
│   b3:
│     branch v1, b4, b5
│   b4:
│     v3 = const 2
│     jump b1
│   b5:
│     v4 = const 3
│     jump b1

--- while-loop ---
#let x
#let y
#{ while x { y } }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = loop_acc_begin
│     jump b1
│   b1:
│     v5 = phi [b0 v2, b2 v6]
│     branch v3, b2, b3
│   b2:
│     v6 = loop_acc_add v5, v4
│     jump b1
│   b3:
│     v7 = loop_acc_result v5
│     return v7

--- for-loop ---
#let items
#{ for x in items { x } }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = iter_open v0
│     v2 = loop_acc_begin
│     jump b1
│   b1:
│     v5 = phi [b0 v2, b2 v6]
│     v3 = iter_has_next v1
│     branch v3, b2, b3
│   b2:
│     v4 = iter_advance v1
│     v6 = loop_acc_add v5, v4
│     jump b1
│   b3:
│     v7 = loop_acc_result v5
│     return v7

--- for-loop-with-pattern ---
#let dict
#{ for (k, v) in dict { k } }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = iter_open v0
│     v2 = loop_acc_begin
│     jump b1
│   b1:
│     v8 = phi [b0 v2, b2 v9]
│     v3 = iter_has_next v1
│     branch v3, b2, b3
│   b2:
│     v4 = iter_advance v1
│     length_check v4, want=2
│     v6 = extract v4[0]
│     v7 = extract v4[1]
│     v9 = loop_acc_add v8, v6
│     jump b1
│   b3:
│     v10 = loop_acc_result v8
│     return v10

--- break ---
#{ while true { break } }
│ fn $top:
│   b0:
│     v0 = loop_acc_begin
│     jump b1
│   b1:
│     v5 = phi [b0 v0, b4 v3]
│     v1 = const true
│     branch v1, b2, b3
│   b2:
│     jump b3
│   b3:
│     v6 = loop_acc_result v5
│     return v6
│   b4:
│     v2 = const none
│     v3 = loop_acc_add <noref>, v2
│     jump b1

--- continue ---
#{ while true { continue } }
│ fn $top:
│   b0:
│     v0 = loop_acc_begin
│     jump b1
│   b1:
│     v4 = phi [b0 v0, b2 v4, b4 v3]
│     v1 = const true
│     branch v1, b2, b3
│   b2:
│     jump b1
│   b3:
│     v5 = loop_acc_result v4
│     return v5
│   b4:
│     v2 = const none
│     v3 = loop_acc_add <noref>, v2
│     jump b1

--- return-with-value ---
#{ let f() = { return 1 } }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_0
│     v1 = const none
│     return v1
│ 
│ fn $fn_0 name="f":
│   b0:
│     v0 = const 1
│     return v0
│   b1:
│     v1 = const none
│     return v1

--- return-without-value ---
#{ let f() = { return } }
│ fn $top:
│   b0:
│     v0 = make_closure $fn_0
│     v1 = const none
│     return v1
│ 
│ fn $fn_0 name="f":
│   b0:
│     return
│   b1:
│     v0 = const none
│     return v0

--- include ---
#{ include "other.typ" }
│ fn $top:
│   b0:
│     v0 = const other.typ
│     v1 = module_include v0
│     return v1

--- context-expression ---
#let text
#{ context text.lang }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = field_read v0.lang
│     v2 = contextual v1
│     return v2

--- destructuring-assignment ---
#let expr
#{ _ = expr }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     return v1

--- tuple-destructuring ---
#let x
#let y
#let point
#{ (x, y) = point }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = const none
│     length_check v2, want=2
│     v4 = extract v2[0]
│     v5 = extract v2[1]
│     v6 = const none
│     return v6

--- spread-in-destructuring ---
#let first
#let rest
#let arr
#{ (first, ..rest) = arr }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = const none
│     v3 = const none
│     return v3

--- named-in-destructuring ---
#let a
#let b
#let point
#{ (x: a, y: b) = point }
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const none
│     v2 = const none
│     length_check v2, want=0
│     v4 = const none
│     return v4

--- literals-none-auto-bool ---
#none #auto #true #false
│ fn $top:
│   b0:
│     v0 = const none
│     v1 = const auto
│     v2 = const true
│     v3 = const false
│     v4 = content_result [v0, v1, v2, v3]
│     return v4

--- literal-int ---
#42
│ fn $top:
│   b0:
│     v0 = const 42
│     return v0

--- literal-float ---
#3.14
│ fn $top:
│   b0:
│     v0 = const 3.14
│     return v0

--- literal-numeric ---
#12pt
│ fn $top:
│   b0:
│     v0 = const 12pt
│     return v0
