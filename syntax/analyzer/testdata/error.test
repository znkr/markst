--- break-in-closure-inside-loop ---
// A break inside a closure must not target a loop in the enclosing function.
#{
  for x in (1, 2, 3) {
    // Error: 21-26 break outside of loop
    let f = () => { break }
    f()
  }
}
│ fn $top:
│   b0:
│     v0 = const 1
│     v1 = const 2
│     v2 = const 3
│     v3 = make_array [v0, v1, v2]
│     v4 = iter_open v3
│     v5 = loop_acc_begin
│     jump b1
│   b1:
│     v10 = phi [b0 v5, b2 v11]
│     v6 = iter_has_next v4
│     branch v6, b2, b3
│   b2:
│     v7 = iter_advance v4
│     v8 = make_closure $fn_0
│     v9 = call v8()
│     v11 = loop_acc_add v10, v9
│     jump b1
│   b3:
│     v12 = loop_acc_result v10
│     return v12
│ 
│ fn $fn_0 name="f":
│   b0:
│     v0 = error msg="break outside of loop"
│     return v0

