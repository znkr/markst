--- duplicate-args-sink ---
// Error: 15-18 only one arguments sink is allowed
#{ let f(..a, ..b) = 1 }
│ fn $top:
│   b0:
│     v0 = const text " "
│     v1 = error msg="only one argument sink is allowed"
│     v2 = make_closure $fn_0
│     v3 = content_result [v0]
│     return v3
│ 
│ fn $fn_0 name="f" params=[v0=..a, v1=..b]:
│   b0:
│     return 1

--- duplicate-destructuring-sink ---
#{
  let x
  // Error: 13-16 only one destructuring sink is allowed
  let (..a, ..b) = x
}
│ fn $top:
│   b0:
│     v0 = error msg="only one destructuring sink is allowed"
│     v1 = destruct_array none, before=0, after=0, has_sink
│     v2 = array_slice v1[0:len-0]
│     return none

