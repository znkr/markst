--- break-in-closure-inside-loop ---
// A break inside a closure must not target a loop in the enclosing function.
#{
  for x in (1, 2, 3) {
    // Error: 21-26 break outside of loop
    let f = () => { break }
    f()
  }
}
│ fn $top:
│   b0:
│     v0 = const text " "
│     v1 = make_array [1, 2, 3]
│     v2 = iter_open v1
│     v3 = join_begin
│     jump b1(v3)
│   b1(v8):
│     v4 = iter_has_next v2
│     branch v4, b2, b3
│   b2:
│     v5 = iter_advance v2
│     v6 = make_closure $fn_0
│     v7 = call v6()
│     v9 = join_add v8, v7
│     jump b1(v9)
│   b3:
│     v10 = join_result v8
│     v11 = content_result [v0, v10]
│     return v11
│ 
│ fn $fn_0:
│   b0:
│     v0 = error msg="cannot break outside of loop"
│     return v0

--- continue-in-closure-inside-loop ---
#{
  for x in (1, 2, 3) {
    // Error: 21-29 continue outside of loop
    let f = () => { continue }
    f()
  }
}
│ fn $top:
│   b0:
│     v0 = make_array [1, 2, 3]
│     v1 = iter_open v0
│     v2 = join_begin
│     jump b1(v2)
│   b1(v7):
│     v3 = iter_has_next v1
│     branch v3, b2, b3
│   b2:
│     v4 = iter_advance v1
│     v5 = make_closure $fn_0
│     v6 = call v5()
│     v8 = join_add v7, v6
│     jump b1(v8)
│   b3:
│     v9 = join_result v7
│     return v9
│ 
│ fn $fn_0:
│   b0:
│     v0 = error msg="cannot continue outside of loop"
│     return v0

--- destructuring-assign-invalid-lvalue ---
#{
  let a = 1
  let b = 2
  (a + b, c) = (1, 2)
}
│ fn $top:
│   b0:
│     v0 = error msg="unexpected plus"
│     return none

