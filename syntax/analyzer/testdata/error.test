--- int-base-hex-invalid ---
// Error: 2-8 invalid hexadecimal number: 0x123z
#0x123z
│ fn $top:
│   b0:
│     v0 = const text " "
│     v1 = error msg="invalid hexadecimal number: 0x123z"
│     v2 = content_result [v0, v1]
│     return v2

