--- duplicate-args-sink ---
// Error: 15-18 only one arguments sink is allowed
#{ let f(..a, ..b) = 1 }
│ fn $top:
│   b0:
│     v0 = error msg="only one arguments sink is allowed"
│     v1 = make_closure $fn_0
│     v2 = const none
│     return v2
│ 
│ fn $fn_0 name="f" params=[v0=..a, v1=..b]:
│   b0:
│     v2 = const 1
│     return v2

