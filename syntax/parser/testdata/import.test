§ Import nested paths with rename
#{ import "mod.typ": a.b as x, c.d.e as y }
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       ModuleImport
│         Import: "import"
│         Space: " "
│         Str: "\"mod.typ\""
│         Colon: ":"
│         Space: " "
│         ImportItems
│           RenamedImportItem
│             ImportItemPath
│               Ident: "a"
│               Dot: "."
│               Ident: "b"
│             Space: " "
│             As: "as"
│             Space: " "
│             Ident: "x"
│           Comma: ","
│           Space: " "
│           RenamedImportItem
│             ImportItemPath
│               Ident: "c"
│               Dot: "."
│               Ident: "d"
│               Dot: "."
│               Ident: "e"
│             Space: " "
│             As: "as"
│             Space: " "
│             Ident: "y"
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

§ Import multiline parenthesized
#{
  import "utils.typ": (
    foo,
    bar,
    baz
  )
}
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: "\n  "
│       ModuleImport
│         Import: "import"
│         Space: " "
│         Str: "\"utils.typ\""
│         Colon: ":"
│         Space: " "
│         LeftParen: "("
│         Space: "\n    "
│         ImportItems
│           ImportItemPath
│             Ident: "foo"
│           Comma: ","
│           Space: "\n    "
│           ImportItemPath
│             Ident: "bar"
│           Comma: ","
│           Space: "\n    "
│           ImportItemPath
│             Ident: "baz"
│         Space: "\n  "
│         RightParen: ")"
│       Space: "\n"
