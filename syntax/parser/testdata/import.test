§ Basic import
#{ import "utils.typ" }
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       ModuleImport
│         Import: "import"
│         Space: " "
│         Str: "\"utils.typ\""
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

§ Import with module rename
#{ import "utils.typ" as utils }
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       ModuleImport
│         Import: "import"
│         Space: " "
│         Str: "\"utils.typ\""
│         Space: " "
│         As: "as"
│         Space: " "
│         Ident: "utils"
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

§ Import wildcard
#{ import "utils.typ": * }
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       ModuleImport
│         Import: "import"
│         Space: " "
│         Str: "\"utils.typ\""
│         Colon: ":"
│         Space: " "
│         Star: "*"
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

§ Import single item
#{ import "utils.typ": foo }
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       ModuleImport
│         Import: "import"
│         Space: " "
│         Str: "\"utils.typ\""
│         Colon: ":"
│         Space: " "
│         ImportItems
│           ImportItemPath
│             Ident: "foo"
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

§ Import multiple items
#{ import "utils.typ": foo, bar, baz }
