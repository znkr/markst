--- basic-label ---
<intro>
│ Markup
│   Label: "<intro>"
│   Space: "\n"

--- label-with-text-before ---
Some text <label>
│ Markup
│   Text: "Some text"
│   Space: " "
│   Label: "<label>"
│   Space: "\n"

--- label-with-text-after ---
<label> more text
│ Markup
│   Label: "<label>"
│   Space: " "
│   Text: "more text"
│   Space: "\n"

--- label-on-heading ---
= Introduction <intro>
│ Markup
│   Heading
│     HeadingMarker: "="
│     Space: " "
│     Markup
│       Text: "Introduction"
│   Space: " "
│   Label: "<intro>"
│   Space: "\n"

--- multiple-labels ---
<first> <second>
│ Markup
│   Label: "<first>"
│   Space: " "
│   Label: "<second>"
│   Space: "\n"

--- label-with-numbers ---
<section1>
│ Markup
│   Label: "<section1>"
│   Space: "\n"

--- label-with-underscore ---
<my_label>
│ Markup
│   Label: "<my_label>"
│   Space: "\n"

--- label-with-hyphen ---
<my-label>
│ Markup
│   Label: "<my-label>"
│   Space: "\n"

--- label-with-colon ---
<fig:intro>
│ Markup
│   Label: "<fig:intro>"
│   Space: "\n"

--- label-with-dot ---
<ch.1>
│ Markup
│   Label: "<ch.1>"
│   Space: "\n"

--- label-with-mixed-chars ---
<fig:intro-1.2_a>
│ Markup
│   Label: "<fig:intro-1.2_a>"
│   Space: "\n"

--- label-and-reference ---
= Heading <heading>
See @heading for more.
│ Markup
│   Heading
│     HeadingMarker: "="
│     Space: " "
│     Markup
│       Text: "Heading"
│   Space: " "
│   Label: "<heading>"
│   Space: "\n"
│   Text: "See"
│   Space: " "
│   Ref
│     RefMarker: "@heading"
│   Space: " "
│   Text: "for more."
│   Space: "\n"

--- reference-with-content ---
See @heading[the heading] here.
│ Markup
│   Text: "See"
│   Space: " "
│   Ref
│     RefMarker: "@heading"
│     ContentBlock
│       LeftBracket: "["
│       Markup
│         Text: "the heading"
│       RightBracket: "]"
│   Space: " "
│   Text: "here."
│   Space: "\n"
