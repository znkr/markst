│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       Unary
│         Plus: "+"
│         Int: "1"
│       Semicolon: ";"
│       Space: " "
│       Unary
│         Minus: "-"
│         Int: "2"
│       Semicolon: ";"
│       Space: " "
│       Unary
│         Not: "not"
│         Space: " "
│         Bool: "true"
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

