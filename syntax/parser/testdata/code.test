--- simple-literals ---
#none #auto #true #false
│ Markup
│   Hash: "#"
│   None: "none"
│   Space: " "
│   Hash: "#"
│   Auto: "auto"
│   Space: " "
│   Hash: "#"
│   Bool: "true"
│   Space: " "
│   Hash: "#"
│   Bool: "false"
│   Space: "\n"

--- numbers ---
#1 #3.14 #12pt
│ Markup
│   Hash: "#"
│   Int: "1"
│   Space: " "
│   Hash: "#"
│   Float: "3.14"
│   Space: " "
│   Hash: "#"
│   Numeric: "12pt"
│   Space: "\n"

--- strings ---
#"hello"
│ Markup
│   Hash: "#"
│   Str: "\"hello\""
│   Space: "\n"

--- field-access ---
#foo.bar.baz
│ Markup
│   Hash: "#"
│   FieldAccess
│     FieldAccess
│       Ident: "foo"
│       Dot: "."
│       Ident: "bar"
│     Dot: "."
│     Ident: "baz"
│   Space: "\n"

--- code-block ---
#{ 1 }
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       Int: "1"
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

