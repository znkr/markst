--- unexpected-right-bracket ---
]
│ Markup
│   Error: "]"
│     Msg: "unexpected ]"
│     Hint: "try using a backslash escape: \\]"
│   Space: "\n"

--- unexpected-token-in-code ---
#{ @ }
│ Markup
│   Hash: "#"
│   CodeBlock
│     LeftBrace: "{"
│     Code
│       Space: " "
│       Error: "@"
│         Msg: "unexpected character: @"
│       Space: " "
│     RightBrace: "}"
│   Space: "\n"

--- missing-expression-after-hash ---
#
│ Markup
│   Hash: "#"
│   Error
│     Msg: "expected expression"
│   Space: "\n"

