§ Block multiple lines
```go
package main

import "fmt"

func main() {
    fmt.Println("Hi")
}
```
│ Markup
│   Raw
│     RawDelim: "```"
│     RawLang: "go"
│     RawTrimmed: "\n"
│     Text: "package main"
│     RawTrimmed: "\n"
│     Text: ""
│     RawTrimmed: "\n"
│     Text: "import \"fmt\""
│     RawTrimmed: "\n"
│     Text: ""
│     RawTrimmed: "\n"
│     Text: "func main() {"
│     RawTrimmed: "\n"
│     Text: "    fmt.Println(\"Hi\")"
│     RawTrimmed: "\n"
│     Text: "}"
│     RawTrimmed: "\n"
│     RawDelim: "```"
│   Space: "\n"

