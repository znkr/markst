// Structural tests for #set / #show rule evaluation. Rules are recorded as a
// deferred value.Templated wrapper around the siblings they scope over; the
// styling effect is not resolved (no realize pass yet), so these assert the
// wrapper structure, not rendered output.
//
// Set-rule arguments are validated against the element's own parameters, so the
// tests use `level` (heading's one modeled property); a bogus property errors
// (see template-set-unknown-property).

--- template-set-scopes-following-siblings ---
= A
#set heading(level: 2)
= B
│ #heading(level: 1)
│ #templated(set heading(level: #2), body: [#heading(level: 1)])

--- template-set-if-false-noop ---
#set heading(level: 2) if false
= B
│ #heading(level: 1)

--- template-set-if-true ---
#set heading(level: 2) if true
= B
│ #templated(set heading(level: #2), body: [#heading(level: 1)])

--- template-consecutive-sets-nest ---
#set heading(level: 2)
#set heading(level: 3)
= B
│ #templated(set heading(level: #2), body: [#templated(set heading(level: #3), body: [#heading(level: 1)])])

--- template-set-code-mode ---
#{
  [A]
  set heading(level: 2)
  [B]
}
│ #text("A")
│ #templated(set heading(level: #2), body: [#text("B")])

--- template-set-unknown-property ---
// Error: 14-29 unexpected argument: numbering
#set heading(numbering: "1.")
= B

--- template-unattached-label-warn ---
#set heading(level: 2)
// Warning: 1-4 label `<a>` is not attached to anything
<a>

--- template-show-element ---
#show heading: emph
= A
│ #templated(show heading: #emph, body: [#heading(level: 1)])

--- template-show-where-selector ---
#show heading.where(label: <x>): emph
= A
│ #templated(show heading.where(label: <x>): #emph, body: [#heading(level: 1)])

--- template-show-label-selector ---
#show <x>: emph
= A
│ #templated(show <x>: #emph, body: [#heading(level: 1)])

--- template-element-constructor-call ---
#heading(level: 2)[Title]
│ #heading(level: 2)
