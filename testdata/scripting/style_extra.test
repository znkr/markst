// Tests for #set / #show rule evaluation, after the realization pass. `#show`
// recipes are applied to matching content; `#set` rules are consumed and
// realized away without styling effect (element-property defaults aren't
// modeled yet — only `set document(title:)` in realize_extra takes effect), so
// the set scopes below leave the headings at their explicit level.
//
// Set-rule arguments are still validated against the element's own parameters,
// so the tests use `level` (heading's one modeled property); a bogus property
// errors (see style-set-unknown-property).

--- style-set-scopes-following-siblings ---
= A
#set heading(level: 2)
= B
│ #document[
│   #heading(level: 1)[A]
│   #heading(level: 1)[B]
│ ]

--- style-set-if-false-noop ---
#set heading(level: 2) if false
= B
│ #document[#heading(level: 1)[B]]

--- style-set-if-true ---
#set heading(level: 2) if true
= B
│ #document[#heading(level: 1)[B]]

--- style-consecutive-sets-nest ---
#set heading(level: 2)
#set heading(level: 3)
= B
│ #document[#heading(level: 1)[B]]

--- style-set-code-mode ---
#{
  [A]
  set heading(level: 2)
  [B]
}
│ #document[#par[AB]]

--- style-set-unknown-property ---
// Error: 14-29 unexpected argument: numbering
#set heading(numbering: "1.")
= B

--- style-unattached-label-warn ---
#set heading(level: 2)
// Warning: 1-4 label `<a>` is not attached to anything
<a>
│ #document[]

--- style-show-element ---
#show heading: emph
= A
│ #document[#par[#emph[#heading(level: 1)[A]]]]

--- style-show-where-selector ---
#show heading.where(label: <x>): emph
= A <x>
│ #document[#par[#emph[#heading(level: 1)[A]]]]

--- style-show-label-selector ---
#show <x>: emph
= A <x>
│ #document[#par[#emph[#heading(level: 1)[A]]]]

--- style-element-constructor-call ---
#heading(level: 2)[Title]
│ #document[#heading(level: 2)[Title]]
