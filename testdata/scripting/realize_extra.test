// Tests for the realization pass: content is wrapped in a Document, parbreak-
// separated runs become paragraphs, consecutive list/enum/term items are
// grouped, and `set document(title: …)` populates the document title.

--- realize-paragraphs ---
First paragraph.

Second paragraph.
│ #document[
│   #par[First paragraph.]
│   #par[Second paragraph.]
│ ]

--- realize-heading-then-paragraph ---
= Title

Body text.
│ #document[
│   #heading(level: 1)[Title]
│   #par[Body text.]
│ ]

--- realize-markup-list ---
- apples
- pears
│ #document[
│   #list(
│     #list.item[apples],
│     #list.item[pears],
│   )
│ ]

--- realize-markup-enum ---
+ first
+ second
│ #document[
│   #enum(
│     #enum.item(-1)[first],
│     #enum.item(-1)[second],
│   )
│ ]

--- realize-markup-terms ---
/ apples: red
/ pears: green
│ #document[
│   #terms(
│     #terms.item[apples][red],
│     #terms.item[pears][green],
│   )
│ ]

--- realize-list-between-paragraphs ---
Before.
- one
- two
After.
│ #document[
│   #par[Before.]
│   #list(
│     #list.item[one],
│     #list.item[two],
│   )
│   #par[After.]
│ ]

--- realize-items-from-loop ---
// The newline that ends each iteration's item separates nothing: the items
// still group into a single list.
#for x in (1, 2) [- #x
]
│ #document[
│   #list(
│     #list.item[#raw("1")],
│     #list.item[#raw("2")],
│   )
│ ]

--- realize-list-then-paragraph ---
- item

After the list.
│ #document[
│   #list(#list.item[item])
│   #par[After the list.]
│ ]

--- realize-document-title ---
#set document(title: "My Document")
= Hello
│ #document(title: [My Document])[#heading(level: 1)[Hello]]

--- realize-inline-not-paragraphed-in-heading ---
= A *bold* title
│ #document[
│   #heading(level: 1)[A #strong[bold] title]
│ ]

--- realize-document-not-callable ---
// Error: 2-10 element document is not callable
#document()
