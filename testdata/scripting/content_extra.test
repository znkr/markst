// Constructor tests for the content elements. Each element is callable as a
// function that builds its dedicated value.* content type; these mirror the
// content structures existing markup tests produce, but via the element
// constructors.

--- element-linebreak ---
#linebreak()
│ #document[#par[#linebreak()]]

--- element-parbreak ---
#parbreak()
│ #document[]

--- element-raw ---
#raw("let x = 1")
│ #document[#par[#raw("let x = 1")]]

--- element-raw-block-lang ---
#raw("fn main() {}", block: true, lang: "rust")
│ #document[
│   #raw(
│     block: true,
│     lang: "rust",
│     "fn main() {}",
│   )
│ ]

--- element-strong ---
#strong[bold]
│ #document[#par[#strong[bold]]]

--- element-emph ---
#emph[italic]
│ #document[#par[#emph[italic]]]

--- element-heading ---
#heading(level: 2)[Title]
│ #document[#heading(level: 2)[Title]]

--- element-text ---
#text("hello")
│ #document[#par[hello]]

--- element-par ---
#par[a paragraph]
│ #document[#par[a paragraph]]

--- element-link ---
#link("https://example.com")[a site]
│ #document[
│   #par[
│     #link(dest: "https://example.com")[a site]
│   ]
│ ]

--- element-ref ---
#ref(<intro>)
│ #document[#par[#ref(target: "intro")]]

--- element-list ---
#list([apples], [oranges])
│ #document[
│   #list(
│     #list.item[apples],
│     #list.item[oranges],
│   )
│ ]

--- element-list-item ---
#list.item([a single item])
│ #document[#list(#list.item[a single item])]

--- element-list-of-items ---
#list(list.item([first]), list.item([second]))
│ #document[
│   #list(
│     #list.item[first],
│     #list.item[second],
│   )
│ ]

--- element-enum ---
#enum([one], [two])
│ #document[
│   #enum(
│     #enum.item(1)[one],
│     #enum.item(2)[two],
│   )
│ ]

--- element-enum-item ---
#enum.item([numbered], number: 5)
│ #document[#enum(#enum.item(5)[numbered])]

--- element-terms-item ---
#terms.item([term], [description])
│ #document[#terms(#terms.item[term][description])]

--- element-terms ---
#terms(terms.item([apple], [a fruit]), terms.item([oak], [a tree]))
│ #document[
│   #terms(
│     #terms.item[apple][a fruit],
│     #terms.item[oak][a tree],
│   )
│ ]

--- element-table ---
#table([a], [b])
│ #document[#table(columns: 1, a, b)]

--- element-table-columns ---
#table(columns: 2, [a], [b], [c], [d])
│ #document[#table(columns: 2, a, b, c, d)]

--- element-table-header ---
#table(columns: 2, table.header([a], [b]), [c], [d])
│ #document[
│   #table(
│     columns: 2,
│     #table.header(a, b),
│     c,
│     d,
│   )
│ ]

--- element-table-columns-zero ---
// Error: 17-18 columns must be at least 1, found 0
#table(columns: 0, [a])

--- element-table-unknown-named ---
// Error: 8-17 unexpected argument: colums
#table(colums: 2, [a])

--- element-unknown-method ---
// Error: 2-11 `nope` is not a valid method for element `list`
#list.nope()
