// Operator tests specific to this implementation.

--- ops-repeat-string-too-long ---
// Repeating is bounded: the folded result would be petabytes, which the Go
// runtime answers with a `makeslice` panic rather than an allocation failure.
// Error: 3-29 cannot repeat this string 4900980049000000 times
#(70007000 * 70007000 * "00")

--- ops-repeat-array-too-long ---
// Error: 3-29 cannot repeat this array 70007000 times
#((1,) * 70007000 * 70007000)

--- ops-repeat-string-still-works ---
#test(3 * "ab", "ababab")
#test(0 * "ab", "")
│ #document[]

--- ops-repeat-array-still-works ---
#test((1, 2) * 2, (1, 2, 1, 2))
#test((1, 2) * 0, ())
│ #document[]

--- ops-assign-to-universe-constant ---
// A built-in binding names a constant, not a variable, so it cannot be
// assigned to.
// Error: 3-7 cannot mutate a constant: emph
#(emph = 1)

--- ops-compound-assign-to-universe-constant ---
// Error: 3-7 cannot mutate a constant: emph
#(emph += 1)

--- ops-destructuring-assign-to-universe-constant ---
#{
  let a = 1
  // Error: 7-11 cannot mutate a constant: emph
  (a, emph) = (1, 2)
}

--- ops-assign-to-math-constant ---
// Inside an equation the math module is a low-precedence fallback scope, so
// `pi` resolves — to a constant, which is still not assignable.
// Error: 4-6 cannot mutate a constant: pi
$#(pi = 1)$
