// Test fractions.

--- math-frac-baseline ---
// Test that denominator baseline matches in the common case.
$ x = 1/2 = a/(a h) = a/a = a/(1/2) $
│ #document[
│   #math.equation(block: true)[
│     #math.text("x")
│     #math.text("=")
│     #math.frac[#math.text("1")][#math.text("2")]
│     #math.text("=")
│     #math.frac[#math.text("a")][#math.text("a")#math.text("h")]
│     #math.text("=")
│     #math.frac[#math.text("a")][#math.text("a")]
│     #math.text("=")
│     #math.frac[
│       #math.text("a")
│     ][
│       #math.frac[#math.text("1")][#math.text("2")]
│     ]
│   ]
│ ]

--- math-frac-paren-removal ---
// Test parenthesis removal.
$ (|x| + |y|)/2 < [1+2]/3 $
│ #document[
│   #math.equation(block: true)[
│     #math.frac[
│       #math.text("|")
│       #math.text("x")
│       #math.text("|")
│       #math.text("+")
│       #math.text("|")
│       #math.text("y")
│       #math.text("|")
│     ][
│       #math.text("2")
│     ]
│     #math.text("<")
│     #math.frac[
│       #math.lr[
│         #math.text("[")
│         #math.text("1")
│         #math.text("+")
│         #math.text("2")
│         #math.text("]")
│       ]
│     ][
│       #math.text("3")
│     ]
│   ]
│ ]

--- math-frac-large ---
// Test large fraction.
$ x = (-b plus.minus sqrt(b^2 - 4a c))/(2a) $
│ #document[
│   #math.equation(block: true)[
│     #math.text("x")
│     #math.text("=")
│     #math.frac[
│       #math.text("−")
│       #math.text("b")
│       #math.text("±")
│       #math.root[
│         #math.attach(t: [#math.text("2")])[#math.text("b")]
│         #math.text("−")
│         #math.text("4")
│         #math.text("a")
│         #math.text("c")
│       ]
│     ][
│       #math.text("2")
│       #math.text("a")
│     ]
│   ]
│ ]

--- math-binom (skip: binom not implemented) ---
// Test binomial.
$ binom(circle, square) $

--- math-binom-multiple (skip: binom not implemented) ---
// Test multinomial coefficients.
$ binom(n, k_1, k_2, k_3) $

--- math-binom-missing-lower (skip: binom not implemented) ---
// Error: 3-13 missing argument: lower
$ binom(x^2) $

--- math-dif (skip: the dif operator is not implemented; it needs weak spacing, which markst does not model) ---
// Test dif.
$ (dif y)/(dif x), dif/x, x/dif, dif/dif \
  frac(dif y, dif x), frac(dif, x), frac(x, dif), frac(dif, dif) $

--- math-frac-associativity ---
// Test associativity.
$ 1/2/3 = (1/2)/3 = 1/(2/3) $
│ #document[
│   #math.equation(block: true)[
│     #math.frac[
│       #math.frac[#math.text("1")][#math.text("2")]
│     ][
│       #math.text("3")
│     ]
│     #math.text("=")
│     #math.frac[
│       #math.frac[#math.text("1")][#math.text("2")]
│     ][
│       #math.text("3")
│     ]
│     #math.text("=")
│     #math.frac[
│       #math.text("1")
│     ][
│       #math.frac[#math.text("2")][#math.text("3")]
│     ]
│   ]
│ ]

--- math-frac-tan-sin-cos ---
// A nice simple example of a simple trig property.
$ tan(x) = sin(x) / cos(x) \
  tan x = (sin x) / (cos x) $
│ #document[
│   #math.equation(block: true)[
│     #math.op[#math.text("tan")]
│     #math.lr[
│       #math.text("(")
│       #math.text("x")
│       #math.text(")")
│     ]
│     #math.text("=")
│     #math.frac[
│       #math.op[#math.text("sin")]
│       #math.lr[
│         #math.text("(")
│         #math.text("x")
│         #math.text(")")
│       ]
│     ][
│       #math.op[#math.text("cos")]
│       #math.lr[
│         #math.text("(")
│         #math.text("x")
│         #math.text(")")
│       ]
│     ]
│     #linebreak()
│     #math.op[#math.text("tan")]
│     #math.text("x")
│     #math.text("=")
│     #math.frac[
│       #math.op[#math.text("sin")]
│       #math.text("x")
│     ][
│       #math.op[#math.text("cos")]
│       #math.text("x")
│     ]
│   ]
│ ]

--- math-frac-precedence ---
// Test precedence.
$ a_1/b_2, 1/f(x), zeta(x)/2, "foo"[|x|]/2 \
  1.2/3.7, 2.3^3.4 \
  f [x]/2, phi [x]/2 \
  +[x]/2, 1(x)/2, 2[x]/2, 🏳️‍🌈[x]/2 \
  (a)b/2, b(a)[b]/2 \
  n!/2, 5!/2, n !/2, 1/n!, 1/5! $
│ #document[
│   #math.equation(block: true)[
│     #math.frac[
│       #math.attach(b: [#math.text("1")])[#math.text("a")]
│     ][
│       #math.attach(b: [#math.text("2")])[#math.text("b")]
│     ]
│     #math.text(",")
│     #math.frac[
│       #math.text("1")
│     ][
│       #math.text("f")
│       #math.lr[
│         #math.text("(")
│         #math.text("x")
│         #math.text(")")
│       ]
│     ]
│     #math.text(",")
│     #math.frac[
│       #math.text("ζ")
│       #math.lr[
│         #math.text("(")
│         #math.text("x")
│         #math.text(")")
│       ]
│     ][
│       #math.text("2")
│     ]
│     #math.text(",")
│     #math.frac[
│       #math.text("foo")
│       #math.lr[
│         #math.text("⟦")
│         #math.text("x")
│         #math.text("⟧")
│       ]
│     ][
│       #math.text("2")
│     ]
│     #linebreak()
│     #math.frac[#math.text("1.2")][#math.text("3.7")]
│     #math.text(",")
│     #math.attach(t: [#math.text("3.4")])[#math.text("2.3")]
│     #linebreak()
│     #math.text("f")
│     #math.frac[
│       #math.lr[
│         #math.text("[")
│         #math.text("x")
│         #math.text("]")
│       ]
│     ][
│       #math.text("2")
│     ]
│     #math.text(",")
│     #math.text("φ")
│     #math.frac[
│       #math.lr[
│         #math.text("[")
│         #math.text("x")
│         #math.text("]")
│       ]
│     ][
│       #math.text("2")
│     ]
│     #linebreak()
│     #math.text("+")
│     #math.frac[
│       #math.lr[
│         #math.text("[")
│         #math.text("x")
│         #math.text("]")
│       ]
│     ][
│       #math.text("2")
│     ]
│     #math.text(",")
│     #math.text("1")
│     #math.frac[#math.text("x")][#math.text("2")]
│     #math.text(",")
│     #math.text("2")
│     #math.frac[
│       #math.lr[
│         #math.text("[")
│         #math.text("x")
│         #math.text("]")
│       ]
│     ][
│       #math.text("2")
│     ]
│     #math.text(",")
│     #math.text("🏳")
