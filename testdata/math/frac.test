│   ]
│ ]

--- math-frac-implicit-func ---
// Test other precedence interactions with implicit function calls.
$
  f'(x) / f_pi{x} \
  sin^2(x) / f_0(x) quad f!(x) / g^(-1)(x) \
  a_\u{2a}[|x} / a_"2a"{x|] quad f_pi.alt{x} / f_#math.pi.alt{x} \
  a(b)_c(d)^e(f) / g(h)'_i(j)' \
  (x)'(x)'(x)' / (x)'(x)'(x)' \
$
│ #document[
│   #math.equation(block: true)[
│     #math.primes(count: 1)[#math.text("f")]
│     #math.frac[
│       #math.text("x")
│     ][
│       #math.attach(
│         b: [
│           #math.text("π")
│           #math.lr[
│             #math.text("{")
│             #math.text("x")
│             #math.text("}")
│           ]
│         ],
│       )[#math.text("f")]
│     ]
│     #linebreak()
│     #math.attach(t: [#math.text("2")])[#math.op[#math.text("sin")]]
│     #math.frac[
│       #math.text("x")
│     ][
│       #math.attach(b: [#math.text("0")])[#math.text("f")]
│     ]
│     #math.lr[
│       #math.text("(")
│       #math.text("x")
│       #math.text(")")
│     ]
│     #h(1em)
│     #math.text("f")
│     #math.text("!")
│     #math.frac[
│       #math.text("x")
│     ][
