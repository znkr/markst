// Test math accents.

--- math-accent-sym-call ---
// Test function call.
$ grave(a), acute(b), hat(f), tilde(§), macron(ä), dash(ä), breve(ä), \
  dot(!), dot.double(a), diaer(a), dot.triple(a), dot.quad(a), circle(a), \
  acute.double(a), caron(@), arrow(Z), arrow.l(Z), arrow.l.r(Z), \
  harpoon(a), harpoon.lt(a) $
│ #document[
│   #math.equation(block: true)[
│     #math.accent(accent: "̀")[#math.text("a")]
│     #math.text(",")
│     #math.accent(accent: "́")[#math.text("b")]
│     #math.text(",")
│     #math.accent(accent: "̂")[#math.text("f")]
│     #math.text(",")
│     #math.accent(accent: "̃")[#math.text("§")]
│     #math.text(",")
│     #math.accent(accent: "̄")[#math.text("ä")]
│     #math.text(",")
│     #math.accent(accent: "̅")[#math.text("ä")]
│     #math.text(",")
│     #math.accent(accent: "̆")[#math.text("ä")]
│     #math.text(",")
│     #linebreak()
│     #math.accent(accent: "̇")[#math.text("!")]
│     #math.text(",")
│     #math.accent(accent: "̈")[#math.text("a")]
│     #math.text(",")
│     #math.accent(accent: "̈")[#math.text("a")]
│     #math.text(",")
│     #math.accent(accent: "⃛")[#math.text("a")]
│     #math.text(",")
│     #math.accent(accent: "⃜")[#math.text("a")]
│     #math.text(",")
│     #math.accent(accent: "̊")[#math.text("a")]
│     #math.text(",")
│     #linebreak()
│     #math.accent(accent: "̋")[#math.text("a")]
│     #math.text(",")
│     #math.accent(accent: "̌")[#math.text("@")]
│     #math.text(",")
│     #math.accent(accent: "⃗")[#math.text("Z")]
│     #math.text(",")
│     #math.accent(accent: "⃖")[#math.text("Z")]
│     #math.text(",")
│     #math.accent(accent: "⃡")[#math.text("Z")]
│     #math.text(",")
│     #linebreak()
│     #math.accent(accent: "⃑")[#math.text("a")]
│     #math.text(",")
│     #math.accent(accent: "⃐")[#math.text("a")]
│   ]
│ ]

--- math-accent-sym-call-error ---
#test(math.tilde(math.pi), math.accent(math.pi, math.tilde))
// Error: 2-9 symbol π is not callable
#math.pi(math.tilde)

