// Test roots.

--- math-root-basic ---
// Test root with more than one character.
$A = sqrt(x + y) = c$
│ #document[
│   #par[
│     #math.equation(block: false)[
│       #math.text("A")
│       #math.text("=")
│       #math.root[
│         #math.text("x")
│         #math.text("+")
│         #math.text("y")
│       ]
│       #math.text("=")
│       #math.text("c")
│     ]
│   ]
│ ]

--- math-root-radical-attachment ---
// Test root size with radicals containing attachments.
$ sqrt(a) quad
  sqrt(f) quad
  sqrt(q) quad
  sqrt(a^2) \
  sqrt(n_0) quad
  sqrt(b^()) quad
  sqrt(b^2) quad
  sqrt(q_1^2) $
│ #document[
│   #math.equation(block: true)[
│     #math.root[#math.text("a")]
│     #h(1em)
│     #math.root[#math.text("f")]
│     #h(1em)
│     #math.root[#math.text("q")]
│     #h(1em)
│     #math.root[
│       #math.attach(t: [#math.text("2")])[#math.text("a")]
│     ]
│     #linebreak()
│     #math.root[
│       #math.attach(b: [#math.text("0")])[#math.text("n")]
│     ]
│     #h(1em)
│     #math.root[
│       #math.attach(t: [])[#math.text("b")]
│     ]
│     #h(1em)
│     #math.root[
│       #math.attach(t: [#math.text("2")])[#math.text("b")]
│     ]
│     #h(1em)
│     #math.root[
│       #math.attach(
│         t: [#math.text("2")],
│         b: [#math.text("1")],
│       )[#math.text("q")]
│     ]
│   ]
│ ]

--- math-root-precomposed ---
// Test precomposed vs constructed roots.
// 3 and 4 are precomposed.
$sqrt(x)$
$root(2, x)$
$root(3, x)$
$root(4, x)$
$root(5, x)$
│ #document[
│   #par[
│     #math.equation(block: false)[#math.root[#math.text("x")]]
│      
│     #math.equation(block: false)[
│       #math.root[#math.text("2")][#math.text("x")]
│     ]
│      
│     #math.equation(block: false)[
│       #math.root[#math.text("3")][#math.text("x")]
│     ]
│      
│     #math.equation(block: false)[
│       #math.root[#math.text("4")][#math.text("x")]
│     ]
│      
│     #math.equation(block: false)[
│       #math.root[#math.text("5")][#math.text("x")]
│     ]
│   ]
│ ]

--- math-root-large-body ---
// Test large bodies
$ sqrt([|x|]^2 + [|y|]^2) < [|z|] $
$ v = sqrt((1/2) / (4/5))
   = root(3, (1/2/3) / (4/5/6))
   = root(4, ((1/2) / (3/4)) / ((1/2) / (3/4))) $
$ v = sqrt(a +\ b) $
│ #document[
│   #math.equation(block: true)[
│     #math.root[
│       #math.attach(t: [#math.text("2")])[
│         #math.lr[#math.text("⟦")][#math.text("x")][#math.text("⟧")]
│       ]
│       #math.text("+")
│       #math.attach(t: [#math.text("2")])[
│         #math.lr[#math.text("⟦")][#math.text("y")][#math.text("⟧")]
│       ]
│     ]
│     #math.text("<")
│     #math.lr[#math.text("⟦")][#math.text("z")][#math.text("⟧")]
│   ]
│   #math.equation(block: true)[
│     #math.text("v")
│     #math.text("=")
│     #math.root[
│       #math.frac[
│         #math.frac[#math.text("1")][#math.text("2")]
│       ][
│         #math.frac[#math.text("4")][#math.text("5")]
│       ]
│     ]
│     #math.text("=")
│     #math.root[
│       #math.text("3")
│     ][
│       #math.frac[
│         #math.frac[
│           #math.frac[#math.text("1")][#math.text("2")]
│         ][
│           #math.text("3")
│         ]
│       ][
│         #math.frac[
│           #math.frac[#math.text("4")][#math.text("5")]
│         ][
│           #math.text("6")
│         ]
│       ]
│     ]
│     #math.text("=")
│     #math.root[
│       #math.text("4")
│     ][
│       #math.frac[
│         #math.frac[
│           #math.frac[#math.text("1")][#math.text("2")]
│         ][
│           #math.frac[#math.text("3")][#math.text("4")]
│         ]
│       ][
│         #math.frac[
│           #math.frac[#math.text("1")][#math.text("2")]
│         ][
│           #math.frac[#math.text("3")][#math.text("4")]
│         ]
│       ]
│     ]
│   ]
│   #math.equation(block: true)[
│     #math.text("v")
│     #math.text("=")
│     #math.root[
│       #math.text("a")
│       #math.text("+")
│       #linebreak()
│       #math.text("b")
│     ]
│   ]
│ ]

--- math-root-large-index ---
// Test large index.
$ root(2, x) quad
  root(3/(2/1), x) quad
  root(1/11, x) quad
  root(1/2/3, 1) $
│ #document[
│   #math.equation(block: true)[
│     #math.root[#math.text("2")][#math.text("x")]
│     #h(1em)
│     #math.root[
│       #math.frac[
│         #math.text("3")
│       ][
│         #math.frac[#math.text("2")][#math.text("1")]
│       ]
│     ][
│       #math.text("x")
│     ]
│     #h(1em)
│     #math.root[
│       #math.frac[#math.text("1")][#math.text("11")]
│     ][
│       #math.text("x")
│     ]
│     #h(1em)
│     #math.root[
│       #math.frac[
│         #math.frac[#math.text("1")][#math.text("2")]
│       ][
│         #math.text("3")
│       ]
│     ][
│       #math.text("1")
│     ]
│   ]
│ ]

--- math-root-syntax ---
// Test shorthand.
$ √2^3 = sqrt(2^3) $
$ √(x+y) quad ∛x quad ∜x $
$ (√2+3) = (sqrt(2)+3) $
│ #document[
│   #math.equation(block: true)[
│     #math.root[
│       #math.attach(t: [#math.text("3")])[#math.text("2")]
│     ]
│     #math.text("=")
│     #math.root[
│       #math.attach(t: [#math.text("3")])[#math.text("2")]
│     ]
│   ]
│   #math.equation(block: true)[
│     #math.root[
│       #math.text("x")
│       #math.text("+")
│       #math.text("y")
│     ]
│     #h(1em)
│     #math.root[#math.text("x")]
│     #h(1em)
│     #math.root[#math.text("x")]
│   ]
│   #math.equation(block: true)[
│     #math.lr[
│       #math.text("(")
│     ][
│       #math.root[#math.text("2")]
│       #math.text("+")
│       #math.text("3")
│     ][
│       #math.text(")")
│     ]
│     #math.text("=")
│     #math.lr[
│       #math.text("(")
│     ][
│       #math.root[#math.text("2")]
│       #math.text("+")
│       #math.text("3")
│     ][
│       #math.text(")")
│     ]
│   ]
│ ]

--- math-root-syntax-prec ---
// Precedence of root syntax with other math operators.
$ √a/b ∛a_b ∜f' √n! \
  √a b^c  √a (b)^c  √a(b)^c $
│ #document[
│   #math.equation(block: true)[
│     #math.frac[#math.root[#math.text("a")]][#math.text("b")]
│     #math.root[
│       #math.attach(b: [#math.text("b")])[#math.text("a")]
│     ]
│     #math.root[
│       #math.primes(count: 1)[#math.text("f")]
│     ]
│     #math.root[#math.text("n")#math.text("!")]
│     #linebreak()
│     #math.root[#math.text("a")]
│     #math.attach(t: [#math.text("c")])[#math.text("b")]
│     #math.root[#math.text("a")]
│     #math.attach(t: [#math.text("c")])[
│       #math.lr[#math.text("(")][#math.text("b")][#math.text(")")]
│     ]
│     #math.root[
│       #math.attach(t: [#math.text("c")])[
│         #math.text("a")
│         #math.lr[#math.text("(")][#math.text("b")][#math.text(")")]
│       ]
│     ]
│   ]
│ ]

--- math-root-frame-size-index (skip: needs #h() spacing function) ---
// Test size of final frame when there is an index.
$ a root(, 3)         & a root(., 3) \
  a sqrt(3)           & a root(2, 3) \
  a root(#h(-1em), 3) & a root(123, 3) $

--- math-root-line-fill-stroke (skip: needs color values and text fill/stroke params) ---
// Test that the horizontal stroke is also decorated like text glyphs
#text(size: 20pt, fill: yellow, stroke: red + .5pt)[$sqrt(Delta)$]
#text(size: 25pt, stroke: red)[$root(3, Delta)$]

--- math-root-index-cramped ---
// Test whether the index has cramped styles.
$ root(x^2^2, 1) $
│ #document[
│   #math.equation(block: true)[
│     #math.root[
│       #math.attach(
│         t: [
│           #math.attach(t: [#math.text("2")])[#math.text("2")]
│         ],
│       )[#math.text("x")]
│     ][
│       #math.text("1")
│     ]
│   ]
│ ]
