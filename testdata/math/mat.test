// Test matrices.

--- math-mat-semicolon (skip: align element not implemented) ---
// Test semicolon syntax.
#set align(center)
$mat() dot
 mat(;) dot
 mat(1, 2) dot
 mat(1, 2;) \
 mat(1; 2) dot
 mat(1, 2; 3, 4) dot
 mat(1 + &2, 1/2; &3, 4)$

--- math-mat-sparse ---
// Test sparse matrix.
$ mat(
  1, 2, ..., 10;
  2, 2, ..., 10;
  dots.v, dots.v, dots.down, dots.v;
  10, 10, ..., 10;
) $
│ #document[
│   #math.equation(block: true)[
│     #math.mat[
│       #math.text("1")
│       #math.text("2")
│       #math.text("…")
│       #math.text("10")
│     ][
│       #math.text("2")
│       #math.text("2")
│       #math.text("…")
│       #math.text("10")
│     ][
│       #math.text("⋮")
│       #math.text("⋮")
│       #math.text("⋱")
│       #math.text("⋮")
│     ][
│       #math.text("10")
│       #math.text("10")
│       #math.text("…")
│       #math.text("10")
│     ]
│   ]
│ ]

--- math-mat-baseline ---
// Test baseline alignment.
$ mat(
  a, b^2;
  sum_(x \ y) x, a^(1/2);
  zeta, alpha;
) $
│ #document[
│   #math.equation(block: true)[
│     #math.mat[
│       #math.text("a")
│       #math.attach(t: [#math.text("2")])[#math.text("b")]
│     ][
│       #math.attach(
│         b: [
│           #math.text("x")
│           #linebreak()
│           #math.text("y")
│         ],
│       )[#math.text("∑")]
│       #math.text("x")
│       #math.attach(
│         t: [
│           #math.frac[#math.text("1")][#math.text("2")]
│         ],
│       )[#math.text("a")]
│     ][
│       #math.text("ζ")
│       #math.text("α")
│     ]
│   ]
│ ]

--- math-mat-delim-set ---
// Test alternative delimiter with set rule.
#set math.mat(delim: "[")
$ mat(1, 2; 3, 4) $
$ a + mat(delim: #none, 1, 2; 3, 4) + b $
│ #document[
│   #math.equation(block: true)[
│     #math.mat[#math.text("1")#math.text("2")][#math.text("3")#math.text("4")]
│   ]
│   #math.equation(block: true)[
│     #math.text("a")
│     #math.text("+")
│     #math.mat[#math.text("1")#math.text("2")][#math.text("3")#math.text("4")]
│     #math.text("+")
│     #math.text("b")
│   ]
│ ]

--- math-mat-delim-direct (skip: align and grid elements not implemented) ---
// Test alternative math delimiter directly in call.
#set align(center)
#grid(
  columns: 3,
  gutter: 10pt,

  $ mat(1, 2, delim: "[") $,
  $ mat(1, 2; delim: "[") $,
  $ mat(delim: "[", 1, 2) $,

  $ mat(1; 2; delim: "[") $,
  $ mat(1; delim: "[", 2) $,
  $ mat(delim: "[", 1; 2) $,

  $ mat(1, 2; delim: "[", 3, 4) $,
  $ mat(delim: "[", 1, 2; 3, 4) $,
  $ mat(1, 2; 3, 4; delim: "[") $,
)

--- math-mat-spread ---
// Test argument spreading in matrix.
$ mat(..#range(1, 5).chunks(2))
  mat(#(..range(2).map(_ => range(2)))) $

#let nums = ((1,) * 5).intersperse(0).chunks(3)
$ mat(..nums, delim: "[") $
│ #document[
│   #math.equation(block: true)[
│     #math.mat[#math.text("1")#math.text("2")][#math.text("3")#math.text("4")]
│     #math.mat[
│       #math.text("0")
│       #math.text("1")
│       #math.text("0")
│       #math.text("1")
│     ]
│   ]
│   #math.equation(block: true)[
│     #math.mat[
│       #math.text("1")
│       #math.text("0")
│       #math.text("1")
│     ][
│       #math.text("0")
│       #math.text("1")
│       #math.text("0")
│     ][
│       #math.text("1")
│       #math.text("0")
│       #math.text("1")
│     ]
│   ]
│ ]

--- math-mat-spread-1d ---
