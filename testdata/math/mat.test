--- math-mat-vec-cases-unity ---
// Test that matrices, vectors, and cases are all laid out the same.
$ mat(z_(n_p); a^2)
  vec(z_(n_p), a^2)
  cases(reverse: #true, delim: \(, z_(n_p), a^2)
  cases(delim: \(, z_(n_p), a^2) $
│ #document[
│   #math.equation(block: true)[
│     #math.mat[
│       #math.attach(
│         b: [
│           #math.attach(b: [#math.text("p")])[#math.text("n")]
│         ],
│       )[#math.text("z")]
│     ][
│       #math.attach(t: [#math.text("2")])[#math.text("a")]
│     ]
│     #math.vec[
│       #math.attach(
