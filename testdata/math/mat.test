│     #math.mat[#math.text("0")#math.text("1")][#math.text("1")#math.text("2")]
│     #linebreak()
│     #math.mat[#math.text("0")#math.text("1")][#math.text("1")#math.text("2")]
│     #math.mat[#math.text("0")#math.text("1")][#math.text("1")#math.text("2")]
│   ]
│ ]

