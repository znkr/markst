│         ],
│       )[#math.text("z")]
│     ][
│       #math.attach(t: [#math.text("2")])[#math.text("a")]
│     ]
│     #math.cases[
│       #math.attach(
│         b: [
│           #math.attach(b: [#math.text("p")])[#math.text("n")]
│         ],
│       )[#math.text("z")]
│     ][
│       #math.attach(t: [#math.text("2")])[#math.text("a")]
│     ]
│     #math.cases[
│       #math.attach(
│         b: [
│           #math.attach(b: [#math.text("p")])[#math.text("n")]
│         ],
│       )[#math.text("z")]
│     ][
│       #math.attach(t: [#math.text("2")])[#math.text("a")]
│     ]
│   ]
